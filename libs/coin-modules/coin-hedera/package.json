{
  "name": "@ledgerhq/coin-hedera",
  "version": "1.40.0",
  "description": "Ledger Hedera Coin integration",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "hbar",
    "Hedera",
    "Hardware Wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/coin-modules/coin-hedera",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib/*"
      ],
      "lib-es/*": [
        "lib-es/*"
      ],
      "*": [
        "lib/*",
        "lib/api/*",
        "lib/bridge/*",
        "lib/logic/*",
        "lib/network/*",
        "lib/signer/*",
        "lib/test/*",
        "lib/types/*"
      ]
    }
  },
  "exports": {
    "./lib/*": "./lib/*.js",
    "./lib-es/*": "./lib-es/*.js",
    "./api/index": {
      "@ledgerhq/source": "./src/api/index.ts",
      "require": "./lib/api/index.js",
      "default": "./lib-es/api/index.js"
    },
    "./bridge/index": {
      "@ledgerhq/source": "./src/bridge/index.ts",
      "require": "./lib/bridge/index.js",
      "default": "./lib-es/bridge/index.js"
    },
    "./config": {
      "@ledgerhq/source": "./src/config.ts",
      "require": "./lib/config.js",
      "default": "./lib-es/config.js"
    },
    "./constants": {
      "@ledgerhq/source": "./src/constants.ts",
      "require": "./lib/constants.js",
      "default": "./lib-es/constants.js"
    },
    "./deviceTransactionConfig": {
      "@ledgerhq/source": "./src/deviceTransactionConfig.ts",
      "require": "./lib/deviceTransactionConfig.js",
      "default": "./lib-es/deviceTransactionConfig.js"
    },
    "./errors": {
      "@ledgerhq/source": "./src/errors.ts",
      "require": "./lib/errors.js",
      "default": "./lib-es/errors.js"
    },
    "./logic/getAssetFromToken": {
      "@ledgerhq/source": "./src/logic/getAssetFromToken.ts",
      "require": "./lib/logic/getAssetFromToken.js",
      "default": "./lib-es/logic/getAssetFromToken.js"
    },
    "./logic/getTokenFromAsset": {
      "@ledgerhq/source": "./src/logic/getTokenFromAsset.ts",
      "require": "./lib/logic/getTokenFromAsset.js",
      "default": "./lib-es/logic/getTokenFromAsset.js"
    },
    "./logic/utils": {
      "@ledgerhq/source": "./src/logic/utils.ts",
      "require": "./lib/logic/utils.js",
      "default": "./lib-es/logic/utils.js"
    },
    "./logic/validateMemo": {
      "@ledgerhq/source": "./src/logic/validateMemo.ts",
      "require": "./lib/logic/validateMemo.js",
      "default": "./lib-es/logic/validateMemo.js"
    },
    "./network/api": {
      "@ledgerhq/source": "./src/network/api.ts",
      "require": "./lib/network/api.js",
      "default": "./lib-es/network/api.js"
    },
    "./preload": {
      "@ledgerhq/source": "./src/preload.ts",
      "require": "./lib/preload.js",
      "default": "./lib-es/preload.js"
    },
    "./preload-data": {
      "@ledgerhq/source": "./src/preload-data.ts",
      "require": "./lib/preload-data.js",
      "default": "./lib-es/preload-data.js"
    },
    "./signer/index": {
      "@ledgerhq/source": "./src/signer/index.ts",
      "require": "./lib/signer/index.js",
      "default": "./lib-es/signer/index.js"
    },
    "./test/index": {
      "@ledgerhq/source": "./src/test/index.ts",
      "require": "./lib/test/index.js",
      "default": "./lib-es/test/index.js"
    },
    "./transaction": {
      "@ledgerhq/source": "./src/transaction.ts",
      "require": "./lib/transaction.js",
      "default": "./lib-es/transaction.js"
    },
    "./types": {
      "@ledgerhq/source": "./src/types/index.ts",
      "require": "./lib/types/index.js",
      "default": "./lib-es/types/index.js"
    },
    "./errors": {
      "@ledgerhq/source": "./src/errors.ts",
      "require": "./lib/errors.js",
      "default": "./lib-es/errors.js"
    },
    "./types/index": {
      "@ledgerhq/source": "./src/types/index.ts",
      "require": "./lib/types/index.js",
      "default": "./lib-es/types/index.js"
    },
    "./*": {
      "@ledgerhq/source": "./src/*.ts",
      "require": "./lib/*.js",
      "default": "./lib-es/*.js"
    },
    "./types/hgraph": {
      "@ledgerhq/source": "./src/types/hgraph.ts",
      "require": "./lib/types/hgraph.js",
      "default": "./lib-es/types/hgraph.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@hashgraph/sdk": "2.78.0",
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/devices": "workspace:*",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/live-countervalues": "workspace:^",
    "@ledgerhq/live-env": "workspace:^",
    "@ledgerhq/live-network": "workspace:^",
    "@ledgerhq/live-promise": "workspace:^",
    "@ledgerhq/logs": "catalog:",
    "@ledgerhq/types-live": "workspace:^",
    "bignumber.js": "^9.1.2",
    "invariant": "^2.2.2",
    "lodash": "^4.17.21",
    "rxjs": "catalog:",
    "viem": "^2.27.0"
  },
  "devDependencies": {
    "@domain/entity-currency-crypto": "workspace:^",
    "@features/platform-currencies": "workspace:^",
    "@ledgerhq/disable-network-setup": "workspace:^",
    "@ledgerhq/wallet-framework-test-setup": "workspace:^",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/invariant": "^2.2.2",
    "@types/jest": "catalog:",
    "@types/lodash": "^4.14.191",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "scripts": {
    "clean": "rimraf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "coverage": "jest --coverage",
    "prewatch": "pnpm build",
    "watch": "tsc --watch --project tsconfig.build.json",
    "watch:es": "tsc --watch --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "doc": "documentation readme src/** --section=API --pe ts --re ts --re d.ts",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "test": "jest",
    "test-integ": "jest --config=jest.integ.config.js",
    "typecheck": "tsc --noEmit --customConditions node",
    "unimported": "unimported",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check"
  }
}
